# Keystone Intelligence Engine - Environment Variables
# Copy to .env and fill in your values

# --- LLM Provider ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Search APIs ---
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
CROSSREF_POLITE_MAILTO=your-email@keystone.com
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_POLITE_MAILTO=your-email@keystone.com

# --- Infrastructure ---
POSTGRES_URL=postgresql+asyncpg://keystone:keystone@localhost:5432/keystone
REDIS_URL=redis://localhost:6379/0
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=keystone

# --- Model Configuration ---
OPUS_MODEL=claude-opus-4-6
SONNET_MODEL=claude-sonnet-4-6
HAIKU_MODEL=claude-haiku-4-5-20251001

# --- Rate Limits ---
MAX_PARALLEL_AGENTS=5
ANTHROPIC_RPM_LIMIT=60
EXA_RPM_LIMIT=100
BRAVE_RPM_LIMIT=100

# --- Evaluation ---
PROMETHEUS_MODEL_PATH=/path/to/prometheus-2-7b
