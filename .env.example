# Keystone Intelligence Engine - Environment Variables
# Copy to .env and fill in your values

# --- LLM Provider ---
OPENAI_API_KEY=sk-...

# --- Search APIs ---
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
CROSSREF_POLITE_MAILTO=your-email@keystone.com
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_POLITE_MAILTO=your-email@keystone.com

# --- Infrastructure ---
POSTGRES_URL=postgresql+asyncpg://keystone:keystone@localhost:5432/keystone
REDIS_URL=redis://localhost:6379/0
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=keystone

# --- Model Configuration ---
FLAGSHIP_MODEL=gpt-5.4
STANDARD_MODEL=gpt-5.4
FAST_MODEL=gpt-5.4-mini

# --- Rate Limits ---
MAX_PARALLEL_AGENTS=5
PROVIDER_RPM_LIMIT=60
EXA_RPM_LIMIT=100
BRAVE_RPM_LIMIT=100

# --- Evaluation ---
PROMETHEUS_MODEL_PATH=/path/to/prometheus-2-7b
