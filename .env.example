# Keystone Intelligence Engine - Environment Variables
# Copy to .env and fill in your values

# === LLM Provider ===
# claude_cli  -- default, uses `claude -p` with Max subscription (3-5s/call, 10 concurrent)
# api_key     -- standard OpenAI API (requires OPENAI_API_KEY)
# codex_oauth -- legacy ChatGPT Codex backend (requires CODEX_AUTH_FILE)
LLM_PROVIDER=claude_cli

# OpenAI API key (only needed if LLM_PROVIDER=api_key)
# OPENAI_API_KEY=sk-...

# Search APIs (at least one required for research agents)
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=

# Deep research mode: L1 agents use multi-turn web research via claude -p
# with WebSearch+WebFetch tools (5-10 min/task, much deeper than shallow mode)
# Set to 1 to enable, unset or 0 for shallow (gateway-based) research
# DEEP_RESEARCH=1

# Model configuration
FLAGSHIP_MODEL=claude-opus-4-6
STANDARD_MODEL=claude-sonnet-4-6
FAST_MODEL=claude-haiku-4-5

# === Phase 2 infrastructure -- not required for MVP ===

# OPENAI_AUTH_TYPE=codex_oauth
# CODEX_AUTH_FILE=~/.codex/auth.json

# Academic search APIs
# CROSSREF_POLITE_MAILTO=your-email@keystone.com
# SEMANTIC_SCHOLAR_API_KEY=
# OPENALEX_POLITE_MAILTO=your-email@keystone.com

# Infrastructure (persistent storage, workflow orchestration)
# POSTGRES_URL=postgresql+asyncpg://keystone:keystone@localhost:5432/keystone
# REDIS_URL=redis://localhost:6379/0
# TEMPORAL_HOST=localhost:7233
# TEMPORAL_NAMESPACE=keystone

# Rate limits
# MAX_PARALLEL_AGENTS=5
# PROVIDER_RPM_LIMIT=60
# EXA_RPM_LIMIT=100
# BRAVE_RPM_LIMIT=100

# Local evaluation model
# PROMETHEUS_MODEL_PATH=/path/to/prometheus-2-7b
